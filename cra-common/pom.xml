<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cra</groupId>
    <artifactId>code-review-agent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>cra-common</artifactId>
  <name>cra-common</name>
  <description>纯 POJO 公共契约：数据模型（05§1）与 SPI 入参出参 POJO；不依赖任何内部模块（10§2 矩阵底座）。唯一编译依赖 jackson-databind（DispositionSupport 平台时间字段容错用，ADR-0016；01§5.2 白名单内）</description>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-ledger-parser</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- 08§7：账本标记解析器 100% 分支覆盖（静默故障类白名单三项之一；
                   2026-11-01 预算执行器与工具白名单两处同级门禁在 cra-core/cra-agents 落齐）；
                   解析器下沉 cra-common 后门禁随迁（ADR-0016），github/gitlab 两份合并为此一份 -->
              <includes>
                <include>org/cra/common/git/LedgerMarkerParser*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
              <haltOnFailure>true</haltOnFailure>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
