# M4b docker-compose 环境变量示例。复制为 docker/.env 后覆盖密钥再启动：
#   cd docker && cp .env.example .env && docker compose up --build
# 生产环境必须使用强随机值；密钥只从环境变量读（05§6）。

# --- PostgreSQL ---
CRA_POSTGRES_DB=cra
CRA_POSTGRES_USER=cra
CRA_POSTGRES_PASSWORD=change-me
CRA_POSTGRES_PORT=55432

# --- 服务密钥（生产必须覆盖） ---
# GitHub webhook HMAC 密钥（与仓库 Settings → Webhooks 中配置一致）
CRA_SERVER_WEBHOOK_SECRET=change-me-webhook
# /api/v1/** Bearer token（报告签发端点）
CRA_SERVER_API_TOKEN=change-me-api-token
# 报告签名 HMAC 密钥（CI 侧用同一值配置 CRA_REPORT_SIGNING_KEY）
CRA_SERVER_SIGNING_KEY=change-me-signing-key
CRA_SERVER_SIGNING_KEY_ID=prod-key-v1
# 只对服务端完成过评审的 commit 签发（推荐 true）
CRA_SERVER_ATTEST_REQUIRE_KNOWN_COMMIT=true

# --- 队列/停机 ---
CRA_SERVER_QUEUE_CAPACITY=100
CRA_SERVER_WORKERS=2
CRA_SERVER_DRAIN_TIMEOUT_SECONDS=30
CRA_SERVER_SHUTDOWN_GRACE=30s

# --- 评审参数 ---
CRA_SERVER_REVIEW_DEPTH=standard
CRA_SERVER_DRY_RUN=false
CRA_SERVER_RUN_TOTAL_TOKENS=500000

# --- GitHub ---
CRA_GITHUB_API_BASE=https://api.github.com
# 建议使用 fine-grained PAT（contents:read + pull-requests:write + issues:write）
CRA_GITHUB_TOKEN=

# --- LLM（必填） ---
CRA_LLM_API_KEY=
CRA_LLM_BASE_URL=https://api.example.com/v1
CRA_LLM_MODEL=standard-model
CRA_LLM_MODEL_STRONG=
CRA_LLM_MODEL_LIGHT=
# 建议 0.2 降低运行间方差（05§5）；空 = 不传
CRA_LLM_TEMPERATURE=0.2
CRA_LLM_FALLBACK_CHAIN=standard,light
CRA_LLM_RPM=

# --- CrossChecker（M4f-lite，默认关闭） ---
CRA_CROSSCHECKER_ENABLED=false
CRA_CROSSCHECKER_MODES=assumption,sniff
CRA_CROSSCHECKER_HISTORY_WEEKS=8

# --- M4f-full 事件史采集（默认关闭；开启时 SOURCE 必填，ADR-0012） ---
CRA_SERVER_EVENT_HISTORY_ENABLED=false
CRA_SERVER_EVENT_HISTORY_CRON=0 0 3 * * *
# 本地路径 / file: URI / http(s) 预签名 URL（JSONL）
CRA_SERVER_EVENT_HISTORY_SOURCE=
CRA_SERVER_EVENT_HISTORY_LOOKBACK_DAYS=7
CRA_SERVER_EVENT_HISTORY_OVERLAP_HOURS=24
CRA_SERVER_EVENT_HISTORY_MAX_ATTEMPTS=3
CRA_SERVER_EVENT_HISTORY_RETRY_BACKOFF_MS=500
CRA_SERVER_EVENT_HISTORY_MAX_BYTES=67108864
CRA_SERVER_EVENT_HISTORY_MAX_EVENTS=5000
