<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cra</groupId>
    <artifactId>code-review-agent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>cra-runner-cli</artifactId>
  <name>cra-runner-cli</name>
  <description>CLI 入口与唯一组合根（M0–M3）：`cra review` 参数解析、退出码、装配（05§3、10§4）；Spring 仅 DI/配置</description>

  <dependencies>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-git</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-git-github</artifactId>
    </dependency>
    <!-- M4e 第二半（ADR-0013）：平台选择；GitLab 实现与 github 实现互不依赖 -->
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-git-gitlab</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-agents</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-store</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-core</artifactId>
    </dependency>
    <!-- Spring 仅 DI/配置且仅在本模块（10§5 R6/R7） -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <!-- 本地形态 SQLite 账本驱动（02§5 本地形态；M2 pre-PR local 模式运行时装载，版本入 root dependencyManagement） -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 结构化 JSON 日志（09§5） -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-logback-encoder.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- GitLab 平台装配的 WireMock 回放（Git/LLM 调用不进单测，07§6.3） -->
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock-standalone</artifactId>
      <version>${wiremock.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <!-- 05§4 cli 分发：shaded jar（M0 自举期仓库内构建；M2 起 Release 二进制） -->
              <shadedArtifactAttached>false</shadedArtifactAttached>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.cra.runner.cli.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
