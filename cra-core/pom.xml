<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cra</groupId>
    <artifactId>code-review-agent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>cra-core</artifactId>
  <name>cra-core</name>
  <description>Orchestrator：Planner/Fan-out/Verify/Aggregate/Publish/Convergence（02§1）；与部署形态无关，账本经 ReviewLedger SPI 访问</description>

  <dependencies>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-git</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-agents</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-store</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-run-budget-tracker</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- 08§7：预算执行器 100% 分支覆盖（静默故障类白名单三项之一，2026-11-01 落地门禁）；
                   预算击穿不抛异常只错账，任何未测分支即静默故障 -->
              <includes>
                <include>org/cra/core/internal/pipeline/RunBudgetTracker*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
              <haltOnFailure>true</haltOnFailure>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
