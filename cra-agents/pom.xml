<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.cra</groupId>
    <artifactId>code-review-agent</artifactId>
    <version>0.1.0</version>
  </parent>

  <artifactId>cra-agents</artifactId>
  <name>cra-agents</name>
  <description>子代理纯定义：角色 prompt 模板、工具白名单、输出 schema（02§3、03§1）；LLM 循环与调度属 cra-core 驱动</description>

  <dependencies>
    <dependency>
      <groupId>org.cra</groupId>
      <artifactId>cra-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>check-tool-whitelist</id>
            <goals><goal>check</goal></goals>
            <configuration>
              <!-- 08§7：工具白名单 100% 分支覆盖（静默故障类白名单三项之一，2026-11-01 落地门禁）；
                   越权工具调用不抛异常只放行，任何未测分支即静默故障 -->
              <includes>
                <include>org/cra/agents/api/ToolWhitelist*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>1.00</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
              <haltOnFailure>true</haltOnFailure>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
